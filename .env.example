# Copy this file to .env and fill in the values

# Claude AI (required)
ANTHROPIC_API_KEY=sk-ant-...

# Google OAuth (required)
# Get from: https://console.cloud.google.com → APIs & Services → Credentials
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# JWT secret — use any long random string
JWT_SECRET=change-this-to-a-long-random-secret-string

# Database (Railway provides this automatically when you add PostgreSQL)
# For local dev you can use SQLite — leave blank or set to sqlite:///./hse.db
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Frontend Google Client ID (used during Docker build)
VITE_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# Photo to Drive bot proxy (optional — Photo Bot tile shows "unreachable" if unset)
# Base URL of the bot's own HTTP API (its Railway public domain), no trailing slash
PHOTOBOT_API_URL=https://photo-to-drive-production.up.railway.app
# Must match BOT_API_TOKEN set on the bot's Railway service
PHOTOBOT_API_TOKEN=change-this-to-a-long-random-secret-string

# Google Drive read access (required for template sync AND the Maintenance
# Report tool's photo search — the service account below must be shared as
# Viewer on the Photo-to-Drive bot's Shared Drive for photo search to work)
# JSON key content (not a file path) — paste the whole service-account JSON, or base64-encode it
GOOGLE_SERVICE_ACCOUNT_JSON=
# Optional fallback for read-only public/link-shared files
GOOGLE_API_KEY=

# Photo-to-Drive bot's Shared Drive root folder ID (same value as DRIVE_PARENT_FOLDER_ID
# on the bot itself) — lets the Maintenance Report tool's "Browse Drive manually"
# fallback start from the right place when auto-search misses a project's photos.
PHOTO_DRIVE_ROOT_FOLDER_ID=
